<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>AutomexiaFileSystem</Name>
      <ViewSelectedBy>
        <TypeName>System.IO.DirectoryInfo</TypeName>
        <TypeName>System.IO.FileInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Icon</Label>
            <Width>4</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Mode</Label>
            <Width>11</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Last Modified</Label>
            <Width>20</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Size</Label>
            <Width>12</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Name</Label>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.PSIsContainer) { [char]0xF07B }
                  elseif ($_.Name -ieq 'Dockerfile') { [char]0xF308 }
                  elseif ($_.Name -ieq 'Cargo.toml') { [char]0xE7A8 }
                  elseif ($_.Name -ieq 'Cargo.lock') { [char]0xE7A8 }
                  elseif ($_.Name -ieq '.gitignore') { [char]0xE702 }
                  elseif ($_.Extension -ieq '.rs') { [char]0xE7A8 }
                  elseif ($_.Extension -ieq '.ps1') { [char]0xE86C }
                  elseif ($_.Extension -ieq '.json') { [char]0xE60B }
                  elseif ($_.Extension -ieq '.toml') { [char]0xE615 }
                  elseif ($_.Extension -ieq '.yaml') { [char]0xE6A8 }
                  elseif ($_.Extension -ieq '.yml') { [char]0xE6A8 }
                  elseif ($_.Extension -ieq '.md') { [char]0xE73E }
                  elseif ($_.Extension -ieq '.git') { [char]0xE702 }
                  elseif ($_.Extension -ieq '.zip') { [char]0xF410 }
                  elseif ($_.Extension -ieq '.exe') { [char]0xF489 }
                  else { [char]0xF15B }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Mode</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss')</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if (-not $_.PSIsContainer) { $_.Length }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($_.PSIsContainer) { $_.Name + [IO.Path]::DirectorySeparatorChar } else { $_.Name }</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>

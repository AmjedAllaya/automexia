<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>AutomexiaFileSystem</Name>
      <ViewSelectedBy>
        <TypeName>System.IO.DirectoryInfo</TypeName>
        <TypeName>System.IO.FileInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Mode</Label>
            <Width>11</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Last Modified</Label>
            <Width>20</Width>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Size</Label>
            <Width>12</Width>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Name</Label>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Mode</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss')</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if (-not $_.PSIsContainer) { $_.Length }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $name = $_.Name
                  $nameKey = $name.ToLowerInvariant()
                  $extension = $_.Extension.ToLowerInvariant()
                  $isLink = ($_.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0
                  $glyph = [char]0xF15B
                  $rgb = '203;213;225'

                  if ($isLink) {
                    $glyph = [char]0xF481
                    $rgb = '45;212;191'
                  } elseif ($_.PSIsContainer) {
                    if ($nameKey -match '^\.?(?:secret|secrets|private|credentials?|keys?|vault|certs?|certificates?)$') {
                      $glyph = [char]0xF023
                      $rgb = '255;92;122'
                    } elseif ($nameKey -match '^\.?(?:config|configs|configuration|settings|etc|profiles?)$') {
                      $glyph = [char]0xF013
                      $rgb = '255;176;32'
                    } elseif ($nameKey -match '^\.?(?:logs?|logfiles?|traces?|telemetry)$') {
                      $glyph = [char]0xF15C
                      $rgb = '242;201;76'
                    } elseif ($nameKey -match '^(?:apps?|src|source|lib|libs|librio(?:-wasm)?|rio-.+|corcovado|sugarloaf|teletypewriter)$') {
                      $glyph = [char]0xF121
                      $rgb = '80;213;255'
                    } elseif ($nameKey -match '^(?:docs?|documentation|guides?|wiki|examples?)$') {
                      $glyph = [char]0xF02D
                      $rgb = '96;211;148'
                    } elseif ($nameKey -match '^(?:tests?|specs?|__tests__|fixtures?|mocks?|fuzz|benches?|benchmarks?)$') {
                      $glyph = [char]0xF0C3
                      $rgb = '220;120;255'
                    } elseif ($nameKey -match '^(?:target|build|dist|out|output|release|debug|artifacts?|coverage|changes)$') {
                      $glyph = [char]0xF1B2
                      $rgb = '244;111;97'
                    } elseif ($nameKey -match '^(?:assets?|public|static|media|images?|icons?|fonts?|resources?)$') {
                      $glyph = [char]0xF1C5
                      $rgb = '244;114;182'
                    } elseif ($nameKey -match '^\.?(?:cargo|node_modules|vendor|vendors|packages?|deps?|dependencies)$') {
                      $glyph = [char]0xF487
                      $rgb = '167;139;250'
                    } elseif ($nameKey -match '^\.?(?:git|github|gitlab)$') {
                      $glyph = [char]0xE702
                      $rgb = '220;120;255'
                    } elseif ($nameKey -match '^(?:bin|scripts?|tools?|shell-integration|ci)$') {
                      $glyph = [char]0xF0AD
                      $rgb = '45;212;191'
                    } elseif ($nameKey -match '^(?:data|db|database|storage|migrations?|schemas?)$') {
                      $glyph = [char]0xF1C0
                      $rgb = '129;140;248'
                    } elseif ($nameKey -match '^\.?(?:cache|tmp|temp|sessions?|backups?)$') {
                      $glyph = [char]0xF017
                      $rgb = '148;163;184'
                    } elseif ($nameKey -match '^(?:infra|infrastructure|terraform|k8s|kubernetes|helm|docker|cloud)$') {
                      $glyph = [char]0xF0C2
                      $rgb = '36;150;237'
                    } elseif ($nameKey -match '^(?:packaging|package)$') {
                      $glyph = [char]0xF487
                      $rgb = '255;176;32'
                    } else {
                      $glyph = [char]0xF07B
                      $rgb = '16;185;255'
                    }
                  } elseif ($nameKey -match '^(?:\.env(?:\..+)?|secrets?(?:\..+)?|credentials?(?:\..+)?|id_(?:rsa|dsa|ecdsa|ed25519))$' -or $extension -in @('.key', '.pem', '.pfx', '.p12', '.kdbx')) {
                    $glyph = [char]0xF023
                    $rgb = '255;92;122'
                  } elseif ($extension -in @('.log', '.trace')) {
                    $glyph = [char]0xF15C
                    $rgb = '242;201;76'
                  } elseif ($extension -in @('.db', '.sqlite', '.sqlite3', '.sql')) {
                    $glyph = [char]0xF1C0
                    $rgb = '129;140;248'
                  } elseif ($name -imatch '^dockerfile(?:\..+)?$' -or $name -imatch '^(?:docker-)?compose.*\.ya?ml$') {
                    $glyph = [char]0xF308
                    $rgb = '36;150;237'
                  } elseif ($name -ieq 'Cargo.toml' -or $name -ieq 'Cargo.lock' -or $extension -eq '.rs') {
                    $glyph = [char]0xE7A8
                    $rgb = '255;176;32'
                  } elseif ($name -in @('.gitignore', '.gitattributes', '.gitmodules') -or $extension -eq '.git') {
                    $glyph = [char]0xE702
                    $rgb = '220;120;255'
                  } elseif ($name -ieq 'Chart.yaml' -or $name -imatch '^kustomization\.ya?ml$') {
                    $glyph = [char]::ConvertFromUtf32(0xF10FE)
                    $rgb = '80;213;255'
                  } elseif ($extension -in @('.tf', '.tfvars', '.hcl')) {
                    $glyph = [char]::ConvertFromUtf32(0xF1062)
                    $rgb = '167;139;250'
                  } elseif ($extension -in @('.ps1', '.psm1', '.psd1')) {
                    $glyph = [char]0xE86C
                    $rgb = '98;176;255'
                  } elseif ($extension -in @('.sh', '.bash', '.zsh', '.fish', '.cmd', '.bat')) {
                    $glyph = [char]0xF121
                    $rgb = '45;212;191'
                  } elseif ($extension -in @('.js', '.jsx', '.ts', '.tsx', '.py', '.go', '.c', '.cc', '.cpp', '.h', '.hpp', '.java', '.kt', '.swift')) {
                    $glyph = [char]0xF121
                    $rgb = '80;213;255'
                  } elseif ($extension -in @('.json', '.jsonc')) {
                    $glyph = [char]0xE60B
                    $rgb = '255;176;32'
                  } elseif ($extension -eq '.toml') {
                    $glyph = [char]0xE615
                    $rgb = '255;176;32'
                  } elseif ($extension -in @('.yaml', '.yml', '.ini', '.cfg', '.conf', '.properties')) {
                    $glyph = [char]0xE6A8
                    $rgb = '255;176;32'
                  } elseif ($extension -in @('.md', '.mdx', '.rst', '.txt')) {
                    $glyph = [char]0xE73E
                    $rgb = '96;211;148'
                  } elseif ($extension -in @('.zip', '.7z', '.rar', '.tar', '.gz', '.bz2', '.xz', '.tgz')) {
                    $glyph = [char]0xF410
                    $rgb = '244;111;97'
                  } elseif ($extension -in @('.png', '.jpg', '.jpeg', '.gif', '.svg', '.webp', '.ico', '.bmp')) {
                    $glyph = [char]0xF1C5
                    $rgb = '244;114;182'
                  } elseif ($extension -in @('.exe', '.msi', '.app', '.deb', '.rpm')) {
                    $glyph = [char]0xF489
                    $rgb = '184;243;107'
                  }
                  $displayName = if ($_.PSIsContainer) {
                    $_.Name + [IO.Path]::DirectorySeparatorChar
                  } else {
                    $_.Name
                  }
                  $escape = [char]27
                  if ($PSVersionTable.PSVersion.Major -ge 7) {
                    "$escape[38;2;${rgb}m$glyph $displayName$escape[0m"
                  } else {
                    # Windows PowerShell 5 does not discount ANSI bytes while
                    # measuring table cells. Keep the category icon but omit
                    # color so narrow names cannot be prematurely truncated.
                    "$glyph $displayName"
                  }
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>

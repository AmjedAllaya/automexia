<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 5 ARM64 package. cargo-packager 0.11.x uses WiX 3, whose compiler cannot
  produce ARM64 MSI databases. Keep this source limited to the unsupported
  target; x64 continues to use the canonical cargo-packager configuration.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Automexia Terminal"
           Manufacturer="Automexia Contributors"
           Version="$(var.ProductVersion)"
           UpgradeCode="A4783F75-5705-4F89-B0BF-A74562D6601D"
           Language="1033"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Automexia Terminal ARM64 installer"
                        Manufacturer="Automexia Contributors" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Automexia Terminal is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AutomexiaTerminal.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AutomexiaTerminal.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="AutomexiaPublisherFolder" Name="Automexia">
        <Directory Id="INSTALLFOLDER" Name="Terminal">
          <Component Id="AutomexiaExecutableComponent" Guid="*" Bitness="always64">
            <File Id="AutomexiaExecutable" Source="$(var.BinaryPath)" Name="automexia.exe" KeyPath="yes">
              <Shortcut Id="AutomexiaStartMenuShortcut"
                        Directory="ProgramMenuFolder"
                        Name="Automexia Terminal"
                        Description="Automexia Terminal"
                        WorkingDirectory="INSTALLFOLDER"
                        Icon="AutomexiaTerminal.exe"
                        Advertise="no" />
            </File>
            <Environment Id="AutomexiaPath"
                         Name="PATH"
                         Value="[INSTALLFOLDER]"
                         Action="set"
                         Part="last"
                         Permanent="no"
                         System="yes" />
            <RegistryKey Root="HKLM" Key="Software\Classes\Directory\shell\AutomexiaTerminal">
              <RegistryValue Type="string" Value="Open Automexia Terminal here" />
              <RegistryKey Key="command">
                <RegistryValue Type="string" Value="&quot;[#AutomexiaExecutable]&quot; --working-dir &quot;%1&quot;" />
              </RegistryKey>
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="Software\Classes\Directory\Background\shell\AutomexiaTerminal">
              <RegistryValue Type="string" Value="Open Automexia Terminal here" />
              <RegistryKey Key="command">
                <RegistryValue Type="string" Value="&quot;[#AutomexiaExecutable]&quot; --working-dir &quot;%V&quot;" />
              </RegistryKey>
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="Software\Classes\automexia">
              <RegistryValue Type="string" Value="URL:Automexia Terminal protocol" />
              <RegistryValue Type="string" Name="URL Protocol" Value="" />
              <RegistryKey Key="DefaultIcon">
                <RegistryValue Type="string" Value="&quot;[#AutomexiaExecutable]&quot;,0" />
              </RegistryKey>
              <RegistryKey Key="shell\open\command">
                <RegistryValue Type="string" Value="&quot;[#AutomexiaExecutable]&quot; &quot;%1&quot;" />
              </RegistryKey>
            </RegistryKey>
          </Component>

          <Component Id="AutomexiaLicenseComponent" Guid="*" Bitness="always64">
            <File Id="AutomexiaLicense" Source="$(var.LicensePath)" Name="LICENSE" KeyPath="yes" />
          </Component>
          <Component Id="AutomexiaNoticeComponent" Guid="*" Bitness="always64">
            <File Id="AutomexiaNotice" Source="$(var.NoticePath)" Name="NOTICE.md" KeyPath="yes" />
          </Component>
          <Component Id="AutomexiaThirdPartyComponent" Guid="*" Bitness="always64">
            <File Id="AutomexiaThirdParty" Source="$(var.ThirdPartyPath)" Name="THIRD_PARTY_NOTICES.md" KeyPath="yes" />
          </Component>
          <Component Id="AutomexiaReadmeComponent" Guid="*" Bitness="always64">
            <File Id="AutomexiaReadme" Source="$(var.ReadmePath)" Name="README.md" KeyPath="yes" />
          </Component>
          <Directory Id="AutomexiaShellIntegrationFolder" Name="shell-integration">
            <Component Id="AutomexiaShellRootComponent" Guid="*" Bitness="always64">
              <File Id="AutomexiaShellInstallWindows" Source="$(var.ShellIntegrationRoot)\install-windows.ps1" Name="install-windows.ps1" KeyPath="yes" />
              <File Id="AutomexiaShellUninstallWindows" Source="$(var.ShellIntegrationRoot)\uninstall-windows.ps1" Name="uninstall-windows.ps1" />
              <File Id="AutomexiaShellWindowsPathSafety" Source="$(var.ShellIntegrationRoot)\windows-path-safety.ps1" Name="windows-path-safety.ps1" />
              <File Id="AutomexiaShellWindowsWsl" Source="$(var.ShellIntegrationRoot)\windows-wsl.ps1" Name="windows-wsl.ps1" />
            </Component>
            <Directory Id="AutomexiaShellPowerShellFolder" Name="powershell">
              <Component Id="AutomexiaShellPowerShellComponent" Guid="*" Bitness="always64">
                <File Id="AutomexiaShellPowerShellScript" Source="$(var.ShellIntegrationRoot)\powershell\automexia.ps1" Name="automexia.ps1" KeyPath="yes" />
                <File Id="AutomexiaShellPowerShellFormat" Source="$(var.ShellIntegrationRoot)\powershell\automexia.format.ps1xml" Name="automexia.format.ps1xml" />
              </Component>
            </Directory>
            <Directory Id="AutomexiaShellCmdFolder" Name="cmd">
              <Component Id="AutomexiaShellCmdComponent" Guid="*" Bitness="always64">
                <File Id="AutomexiaShellCmdScript" Source="$(var.ShellIntegrationRoot)\cmd\automexia.cmd" Name="automexia.cmd" KeyPath="yes" />
                <File Id="AutomexiaShellCmdListLauncher" Source="$(var.ShellIntegrationRoot)\cmd\automexia-ls.cmd" Name="automexia-ls.cmd" />
                <File Id="AutomexiaShellCmdListScript" Source="$(var.ShellIntegrationRoot)\cmd\automexia-ls.ps1" Name="automexia-ls.ps1" />
              </Component>
            </Directory>
            <Directory Id="AutomexiaShellBashFolder" Name="bash">
              <Component Id="AutomexiaShellBashComponent" Guid="*" Bitness="always64">
                <File Id="AutomexiaShellBashScript" Source="$(var.ShellIntegrationRoot)\bash\automexia.bash" Name="automexia.bash" KeyPath="yes" />
              </Component>
            </Directory>
            <Directory Id="AutomexiaShellZshFolder" Name="zsh">
              <Component Id="AutomexiaShellZshComponent" Guid="*" Bitness="always64">
                <File Id="AutomexiaShellZshScript" Source="$(var.ShellIntegrationRoot)\zsh\automexia.zsh" Name="automexia.zsh" KeyPath="yes" />
              </Component>
            </Directory>
            <Directory Id="AutomexiaShellFishFolder" Name="fish">
              <Component Id="AutomexiaShellFishComponent" Guid="*" Bitness="always64">
                <File Id="AutomexiaShellFishScript" Source="$(var.ShellIntegrationRoot)\fish\automexia.fish" Name="automexia.fish" KeyPath="yes" />
              </Component>
            </Directory>
            <Directory Id="AutomexiaShellPosixFolder" Name="posix">
              <Component Id="AutomexiaShellPosixComponent" Guid="*" Bitness="always64">
                <File Id="AutomexiaShellEzaFilter" Source="$(var.ShellIntegrationRoot)\posix\automexia-eza-filter.pl" Name="automexia-eza-filter.pl" KeyPath="yes" />
              </Component>
            </Directory>
            <Directory Id="AutomexiaShellCompletionFolder" Name="completion">
              <Directory Id="AutomexiaShellCompletionPowerShellFolder" Name="powershell">
                <Component Id="AutomexiaShellCompletionPowerShellComponent" Guid="*" Bitness="always64">
                  <File Id="AutomexiaShellCompletionPowerShell" Source="$(var.ShellIntegrationRoot)\completion\powershell\automexia-completion.ps1" Name="automexia-completion.ps1" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="AutomexiaShellCompletionBashFolder" Name="bash">
                <Component Id="AutomexiaShellCompletionBashComponent" Guid="*" Bitness="always64">
                  <File Id="AutomexiaShellCompletionBash" Source="$(var.ShellIntegrationRoot)\completion\bash\automexia-completion.bash" Name="automexia-completion.bash" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="AutomexiaShellCompletionZshFolder" Name="zsh">
                <Component Id="AutomexiaShellCompletionZshComponent" Guid="*" Bitness="always64">
                  <File Id="AutomexiaShellCompletionZsh" Source="$(var.ShellIntegrationRoot)\completion\zsh\automexia-completion.zsh" Name="automexia-completion.zsh" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="AutomexiaShellCompletionFishFolder" Name="fish">
                <Component Id="AutomexiaShellCompletionFishComponent" Guid="*" Bitness="always64">
                  <File Id="AutomexiaShellCompletionFish" Source="$(var.ShellIntegrationRoot)\completion\fish\automexia-completion.fish" Name="automexia-completion.fish" KeyPath="yes" />
                </Component>
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="AutomexiaTerminalFeature" Title="Automexia Terminal" Level="1">
      <ComponentRef Id="AutomexiaExecutableComponent" />
      <ComponentRef Id="AutomexiaLicenseComponent" />
      <ComponentRef Id="AutomexiaNoticeComponent" />
      <ComponentRef Id="AutomexiaThirdPartyComponent" />
      <ComponentRef Id="AutomexiaReadmeComponent" />
      <ComponentRef Id="AutomexiaShellRootComponent" />
      <ComponentRef Id="AutomexiaShellPowerShellComponent" />
      <ComponentRef Id="AutomexiaShellCmdComponent" />
      <ComponentRef Id="AutomexiaShellBashComponent" />
      <ComponentRef Id="AutomexiaShellZshComponent" />
      <ComponentRef Id="AutomexiaShellFishComponent" />
      <ComponentRef Id="AutomexiaShellPosixComponent" />
      <ComponentRef Id="AutomexiaShellCompletionPowerShellComponent" />
      <ComponentRef Id="AutomexiaShellCompletionBashComponent" />
      <ComponentRef Id="AutomexiaShellCompletionZshComponent" />
      <ComponentRef Id="AutomexiaShellCompletionFishComponent" />
    </Feature>
  </Package>
</Wix>

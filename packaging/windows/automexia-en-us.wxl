<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="WelcomeDlgTitle">{\WixUI_Font_Bigger}Welcome to Automexia Terminal</String>
  <String Id="WelcomeDlgDescription">A flexible, open-source terminal for focused command-line work. Click Next to set up Automexia.</String>
  <String Id="MaintenanceWelcomeDlgTitle">{\WixUI_Font_Bigger}Manage Automexia Terminal</String>
  <String Id="MaintenanceWelcomeDlgDescription">Automexia is already installed. Click Next to view setup options, or Cancel to leave it as it is.</String>
  <String Id="InstallDirDlgTitle">{\WixUI_Font_Title}Choose an install folder</String>
  <String Id="InstallDirDlgDescription">Use this folder, or click Change to choose another.</String>
  <String Id="LicenseAgreementDlgTitle">{\WixUI_Font_Title}Automexia license</String>
  <String Id="LicenseAgreementDlgDescription">Review the MIT license before continuing.</String>
  <String Id="VerifyReadyDlgInstallText">Click Install to add Automexia to your computer. Click Back to review your choices.</String>
  <String Id="VerifyReadyDlgRepairText">Click Repair to restore missing or damaged Automexia files.</String>
  <String Id="VerifyReadyDlgRemoveText">Click Remove to uninstall Automexia from your computer.</String>
  <String Id="VerifyReadyDlgChangeText">Click Change to apply your setup choices.</String>
  <String Id="VerifyReadyDlgUpdateText">Click Update to update Automexia.</String>
  <String Id="ProgressDlgTextInstalling">Installing Automexia. This may take a moment.</String>
  <String Id="ProgressDlgTextRepairing">Repairing Automexia. This may take a moment.</String>
  <String Id="ProgressDlgTextRemoving">Removing Automexia. This may take a moment.</String>
  <String Id="ProgressDlgTextChanging">Updating your Automexia setup. This may take a moment.</String>
  <String Id="ProgressDlgTextUpdating">Updating Automexia. This may take a moment.</String>
  <String Id="ExitDialogTitle">{\WixUI_Font_Bigger}Setup complete</String>
  <String Id="ExitDialogDescription">Click Finish to close Automexia setup.</String>
  <String Id="UserExitTitle">{\WixUI_Font_Bigger}Setup cancelled</String>
  <String Id="UserExitDescription1">Automexia setup was cancelled. Run the installer again when you are ready.</String>
  <String Id="UserExitDescription2">Click Finish to close.</String>
</WixLocalization>

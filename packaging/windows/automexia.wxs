<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 fragment consumed by cargo-packager 0.11.8. The packager owns the
  automexia.exe, PATH, shortcut, automexia://, upgrade, and uninstall entries;
  this fragment adds only the two opt-out-safe Explorer launch surfaces.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="AutomexiaDirectoryContextMenu" Guid="*" Win64="yes">
        <Environment Id="AutomexiaPath"
                     Name="PATH"
                     Value="[INSTALLDIR]"
                     Action="set"
                     Part="last"
                     Permanent="no"
                     System="yes" />
        <RegistryKey Root="HKLM" Key="Software\Classes\Directory\shell\AutomexiaTerminal">
          <RegistryValue Type="string" Value="Open Automexia Terminal here" KeyPath="yes" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[!Path]&quot; --working-dir &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\automexia">
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
          <RegistryValue Type="string" Value="URL:Automexia Terminal protocol" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[!Path]&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <Component Id="AutomexiaBackgroundContextMenu" Guid="*" Win64="yes">
        <RegistryKey Root="HKLM" Key="Software\Classes\Directory\Background\shell\AutomexiaTerminal">
          <RegistryValue Type="string" Value="Open Automexia Terminal here" KeyPath="yes" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[!Path]&quot; --working-dir &quot;%V&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="AutomexiaContextMenuComponents">
      <ComponentRef Id="AutomexiaDirectoryContextMenu" />
      <ComponentRef Id="AutomexiaBackgroundContextMenu" />
    </ComponentGroup>
  </Fragment>
</Wix>
